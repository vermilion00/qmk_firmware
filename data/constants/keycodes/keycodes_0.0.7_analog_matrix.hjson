{
    "ranges": {
        "0x7900/0x001F": {
            "define": "AM_PROFILE_RANGE"
        },
        "0x7920/0x001F": {
            "define": "AM_KEYCODE_RANGE"
        },
        "0x7940/0x000B": {
            "define": "AM_JOYSTICK_RANGE"
        }
    },
    "keycodes": {
        // The range between 0x7900 and 0x791F is used by the profile change keycodes, which work like MO(layer)
