{
    "ranges": {
        "0x7900/0x000F": {
            "define": "AM_PROFILE_RANGE"
        },
        "0x7910/0x001F": {
            "define": "AM_KEYCODE_RANGE"
        },
        "0x7930/0x000B": {
            "define": "AM_JOYSTICK_RANGE"
        }
    },
    "keycodes": {
        // The range between 0x7900 and 0x790F is used by the profile change keycodes, which work like MO(layer)
        "0x7910": {
            "group": "analog_matrix",
            "key": "AM_CALIBRATE",
            "aliases": ["AM_CLBR"]
        },
