{
	"keyboard_name": "Tractyl Manuform HE411",
	"maintainer": "vermilion00",
	"manufacturer": "vermilion00",
	"bootloader_instructions": "Hold down the ESC key (top left) for the left side, or the backspace key (top right) for the right side. To start calibration, hold down either of the keys below the bootloader keys.",
    "url": "https://github.com/vermilion00/qmk_firmware",
    "development_board": "blackpill_f411",
    "usb": {
        "pid": "0x3536",
		"vid": "0xFEED",
        "device_version": "2.0.0"
    },
	"build": {
		"firmware_format": "bin",
		"lto": true
	},
    "features": {
        "nkro": false,
        "bootmagic": false,
        "extrakey": true,
        "mousekey": true,
        "console": true,
        "joystick": false
    },
    "debounce": 5,
    "analog_matrix": {
        "hardware": {
            "force_calibrate": false,
            "adc_pins": ["A0", "A1", "A2", "A3", "B0"],
            "direct_pins": ["B12", "B13"],
            "travel_distance": 4.0,
            "smoothing": 60,
            "deadzone": 100,
            "custom_matrix_lite": true
        },
        "config": {
            "bootloader_keys": [0, 5],
            "calibration_keys": [[0, 0], [0, 6]],
            "scans_without_change": 6000,
            "debug_calibration": false,
            "debug_scan_values": false,
            "debug_scan_no_input": false
        },
        "profiles": {
            "default_profile": 0,
            "profile_0": {
                "key_modes": [0],
                "trigger_height": [1.5],
                "release_height": [1.25],
                "layers": [0]
            },
            "profile_1": {
                "key_modes": [0],
                "trigger_height": [1.0],
                "release_height": [0.75],
                "layers": [1, 2]
            }
        }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0, "mux": [0, 0]},
                {"matrix": [0, 1], "x": 1, "y": 0, "mux": [1, 0]},
                {"matrix": [0, 2], "x": 2, "y": 0, "mux": [2, 0]},
                {"matrix": [0, 3], "x": 3, "y": 0, "mux": [3, 0]},
                {"matrix": [0, 4], "x": 3, "y": 0, "mux": [4, 0]},
                {"matrix": [0, 5], "x": 3, "y": 0, "rc":  0},
                {"matrix": [0, 6], "x": 3, "y": 0, "rc":  1}
            ]
        }
    }
}
