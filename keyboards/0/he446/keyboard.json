{
	"keyboard_name": "HE446",
	"maintainer": "vermilion00",
	"manufacturer": "Me",
	"bootloader_instructions": "Test",
    "url": "https://github.com/vermilion00/qmk_firmware",
    "development_board": "blackpill_f446",
    "usb": {
        "pid": "0x3536",
		"vid": "0xFEED",
        "device_version": "2.0.0"
    },
	"build": {
		"firmware_format": "bin",
		"lto": false,
        "debounce_type": "sym_eager_pk"
	},
	"matrix_pins": {
		"direct": [["C13"]]
    },
    "features": {
        "mousekey": true,
        "console": true
    },
    "hall_effect": {
        "hardware": {
            "mux_pins": ["B12"],
            "adc_pins": ["A0", "A6", "A4"],
            "mux_to_num":  [
                [1, 2, 3],
                [0, 0, 4]
            ],
            "num_to_matrix": [[0, 0], [0, 1], [0, 2], [0, 3]],
            "travel_distance": 4.0,
            "smoothing": 1,
            "deadzone": 3
        },
        "config": {
            "scans_without_change": 250000,
            "no_eeprom": true,
            "debug_scan_values": true,
            "top_values": [ 618, 636, 697, 706 ],
            "bottom_values": [ 264, 261, 264, 243 ]
        },
        "profiles": {
            "default_profile": 0,
            "profile_switch_mode": "LAST",
            "profile_0": {
                "rt_press_distance": [0.3],
                "rapid_trigger_type": "constant_rapid_trigger",
                "rapid_trigger_keys": [1],
                "layers": [0, 3, 5, 2, 4]
            },
            "profile_1": {
                "trigger_height": [1.5],
                "release_height": [0.3],
                "rapid_trigger_type": "none",
                "rapid_trigger_keys": [0],
                "layers": [0, 1, 2, 4]
            },"profile_2": {
                "trigger_height": [1.5],
                "release_height": [0.3],
                "rt_press_distance": [0.3],
                "rt_release_distance": [0.5],
                "rapid_trigger_type": "rapid_trigger",
                "rapid_trigger_keys": [1],
                "layers": [0, 1, 2, 4]
            }
        }
    },
    "debounce": 0,
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 0, "y": 0},
                {"matrix": [0, 2], "x": 0, "y": 0},
                {"matrix": [0, 3], "x": 0, "y": 0}
            ]
        }
    }
}
