{
	"keyboard_name": "HE446",
	"maintainer": "vermilion00",
	"manufacturer": "Me",
	"bootloader_instructions": "Test",
    "url": "https://github.com/vermilion00/qmk_firmware",
    "development_board": "blackpill_f446",
    "usb": {
        "pid": "0x3536",
		"vid": "0xFEED",
        "device_version": "2.0.0"
    },
	"build": {
		"firmware_format": "bin",
		"lto": false,
        "debounce_type": "sym_eager_pk"
	},
	"matrix_pins": {
		"direct": [["C13"]]
    },
    "features": {
        "mousekey": true,
        "console": true
    },
    "hall_effect": {
        "hardware": {
            "adc_pins": ["A0", "A6"],
            "mux_to_num":  [[1, 2]],
            "num_to_matrix": [[0, 0], [0, 1]],
            "travel_distance": 4.0,
            "smoothing": 2,
            "deadzone": 6
        },
        "config": {
            "trigger_height": [0.5],
            "release_height": [0.4],
            "rt_press_distance": [0.3],
            "scans_without_change": 250000
        }
    },
    "debounce": 0,
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 0, "y": 0}
            ]
        }
    }
}
