{
	"keyboard_name": "HE446",
	"maintainer": "vermilion00",
	"manufacturer": "Me",
	"bootloader_instructions": "Test",
    "url": "https://github.com/vermilion00/qmk_firmware",
    "development_board": "blackpill_f446",
    "usb": {
        "pid": "0x3536",
		"vid": "0xFEED",
        "device_version": "2.0.0"
    },
	"build": {
		"firmware_format": "bin",
		"lto": false,
        "debounce_type": "sym_eager_pr"
	},
    "features": {
        "rgblight": false,
        "pointing_device": false,
        "bootmagic": false,
        "console": true
    },
    "split": {
        "enabled": true,
        "handedness": {
            "pin": "B1"
        },
        "serial": {
            "driver": "usart"
        }
    },
    "hall_effect": {
        "hardware": {
            "keyboard_side": 1,
            "calibrate": false,
            "mux_pins": ["B12", "B13", "B14", "B15"],
            "adc_pins": ["A0"],
            "travel_distance": 4.0,
            "smoothing": 1,
            "deadzone": 3
        },
        "config": {
            "scans_without_change": 250000,
            "no_eeprom": true,
            "debug_scan_values": false,
            "debug_scan_no_input": false,
            "top_values": [ 729, 659, 646, 660 ],
            "bottom_values": [ 339, 285, 261, 261 ],
            "top_values_right": [ 658, 581, 691, 629 ],
            "bottom_values_right": [ 268, 269, 280, 267 ]
        },
        "profiles": {
            "default_profile": 0,
            "profile_switch_mode": "LAST",
            "profile_0": {
                "trigger_height": [1.0],
                "rt_press_distance": [0.3],
                "rapid_trigger_type": "constant_rapid_trigger",
                "key_modes": [3],
                "layers": [0, 3, 5, 2, 4]
            },
            "profile_1": {
                "trigger_height": [1.5],
                "release_height": [0.3],
                "rapid_trigger_type": "none",
                "key_modes": [0],
                "layers": [0, 1, 2, 4]
            },"profile_2": {
                "trigger_height": [1.5],
                "release_height": [0.3],
                "rt_press_distance": [0.3],
                "rt_release_distance": [0.5],
                "rapid_trigger_type": "rapid_trigger",
                "key_modes": [1]
            }
        }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0, "mux": [0, 0]},
                {"matrix": [0, 1], "x": 0, "y": 0, "mux": [1, 0]},

                {"matrix": [2, 0], "x": 0, "y": 0, "mux": [0, 0]},
                {"matrix": [2, 1], "x": 0, "y": 0, "mux": [1, 0]},

                {"matrix": [1, 0], "x": 0, "y": 0, "mux": [2, 0]},
                {"matrix": [1, 1], "x": 0, "y": 0, "mux": [3, 0]},

                {"matrix": [3, 0], "x": 0, "y": 0, "mux": [2, 0]},
                {"matrix": [3, 1], "x": 0, "y": 0, "mux": [3, 0]}
            ]
        }
    }
}
